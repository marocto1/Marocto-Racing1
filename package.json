{
  "name": "marocto-racing",
  "version": "1.4.0",
  "private": true,
  "scripts": {
    "android:add": "npx cap add android",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "dev": "node scripts/serve.mjs",
    "android:prepare": "node scripts/prepare-android.mjs",
    "pc:dev": "electron .",
    "pc:build": "electron-builder --win portable --x64 --publish never",
    "test:desktop": "node scripts/desktop-smoke.mjs",
    "mw:capture:convert": "node scripts/mw-capture-to-obj.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/core": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sparticuz/chromium": "^153.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "type": "module",
  "description": "Marocto Racing PC: WebGL2 single-player racing with AI",
  "author": "Marocto",
  "main": "desktop/main.cjs",
  "build": {
    "appId": "com.marocto.racing.pc",
    "productName": "Marocto Racing",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**",
      "www/**",
      "third_party/**",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Marocto-Racing-PC-${version}-${arch}.${ext}",
      "signAndEditExecutable": false
    },
    "portable": {
      "requestExecutionLevel": "user"
    }
  }
}
